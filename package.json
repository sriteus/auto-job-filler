{
  "name": "ai-job-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI Job Application Agent - V1 Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
